// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Post {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  price      Int?
  deposit    Int?
  rent       Int?
  sqft       Int?
  images     String[]
  address    String
  city       String
  bedroom    Int
  bathroom   Int
  parking    Int
  facing     String?
  latitude   String?
  longitude  String?
  floorNum   String?
  type       Type
  property   Property
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  userId     String      @db.ObjectId
  postDetail PostDetail?
  savedPosts SavedPost[]
  ratings    Rating[]
  comments   Comment[]
}

model PostDetail {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  desc             String
  utilities        String?
  pet              String?
  income           String?
  size             Int?
  school           Int?
  bus              Int?
  restaurant       Int?
  BHKType          BHK_Type?
  Highlights        Json?
  furnishedType    FurnishingType?
  PreferredTenants PreferredTenants?
  availableWithin  Availability?
  post             Post              @relation(fields: [postId], references: [id])
  postId           String            @unique @db.ObjectId
  createdAt   DateTime?  @default(now())
  SavedPost        SavedPost?
  
}

model SavedPost {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  user       User       @relation(fields: [userId], references: [id])
  post       Post       @relation(fields: [postId], references: [id])
  postDetail PostDetail @relation(fields: [postId], references: [postId])
 // ratings    Rating     @relation(fields: [postId], references: [postId])
  //  userId    String   @unique @db.ObjectId
  ratings    Rating[]
  userId     String     @db.ObjectId
  postId     String     @unique @db.ObjectId
  createdAt  DateTime   @default(now())

  @@unique([userId, postId])
}

model User {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  username   String      @unique
  email      String      @unique
  password   String      @unique
  avatar     String?
  createdAt  DateTime    @default(now())
  post       Post[]
  savedPosts SavedPost[]
  chats      Chat[]      @relation(fields: [chatIDs], references: [id])
  chatIDs    String[]    @db.ObjectId
  Rating     Rating[]
  Comment    Comment[]
}

model Chat {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  users       User[]    @relation(fields: [userIDs], references: [id])
  userIDs     String[]  @db.ObjectId
  createdAt   DateTime  @default(now())
  seenBy      String[]  @db.ObjectId
  messages    Message[]
  lastMessage String?
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  userId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  stars     Float
  post      Post     @relation(fields: [postId], references: [id])
  postId    String    @db.ObjectId
  savedPost SavedPost @relation(fields: [postId],references: [postId])
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

 // SavedPost SavedPost?

 // SavedPost SavedPost[]
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model Hotel {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  type          String
  city          String
  address       String
  distance      String
  photos        String[]
  desc          String
  rating        Float
  rooms         String[]
  cheapestPrice Float
  featured      Boolean
  availRooms    roomBooking[]
}

model roomBooking {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  hotelId          String            @db.ObjectId
  hotelBooking     Hotel             @relation(fields: [hotelId], references: [id])
  title            String
  price            Float
  maxPeople        Int
  desc             String
  roomNumber       Int
  unavailableDates unavailableDate[]
}

model unavailableDate {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  date          DateTime
  roomBookingId String      @db.ObjectId
  roomBooking   roomBooking @relation(fields: [roomBookingId], references: [id])
}

enum Type {
  buy
  rent
  booking
}

enum Property {
  any
  apartment
  house
  villa
  PG
  hotel
  resort
  office_space
  land
}

enum FurnishingType {
  any
  full
  semi
  none
}

enum PreferredTenants {
  any
  family
  company
  bachelor_male
  bachelor_female
}

enum BHK_Type {
  any
  ONE_RK
  ONE_BHK
  TWO_BHK
  THREE_BHK
  FOUR_BHK
  FOUR_PLUS_BHK
}

enum Availability {
  immediate
  within_15_days
  within_30_days
  after_30_days
}
