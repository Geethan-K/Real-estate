// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model LoginInfo {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  user       User?        @relation(fields: [userId], references: [id])
  userId     String?      @db.ObjectId
  loginAt    DateTime?  @default(now())
  isLive     Boolean?
}

model Post {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  price      Int?
  deposit    Int?
  rent       Int?
  sqft       Int?
  images     String[]
  address    String
  city       String
  bedroom    Int
  bathroom   Int
  parking    Int
  facing     String?
  latitude   String?
  longitude  String?
  floorNum   String?
  type       Type
  property   Property
  user       User        @relation(fields: [userId], references: [id])
  userId     String      @db.ObjectId
  postDetail PostDetail?
  savedPosts SavedPost[]
  ratings    Rating[]
  comments   Comment[]
  shares     Share[] 

  notification Notification[]
}

model PostDetail {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  desc             String?
  utilities        String?
  pet              String?
  income           String?
  size             Int?
  school           Int?
  bus              Int?
  restaurant       Int?
  BHKType          String?
  highlights        Json?
  highlightDetails  Json?
  amenities         Json?
  furnishings       Json?
  gatedCommunity  YesOrNo?
  gasPipeline     YesOrNo?
  furnishedType    FurnishingType?
  PreferredTenants PreferredTenants?
  availableWithin  Availability?
  post             Post              @relation(fields: [postId], references: [id])
  postId           String            @unique @db.ObjectId
  createdAt   DateTime?  @default(now())
  SavedPost        SavedPost?
  
}

model SavedPost {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  user       User       @relation(fields: [userId], references: [id])
  post       Post       @relation(fields: [postId], references: [id])
  postDetail PostDetail @relation(fields: [postId], references: [postId])
 // ratings    Rating     @relation(fields: [postId], references: [postId])
  //  userId    String   @unique @db.ObjectId
  likes       Like[]
  shares      Share[]
  ratings    Rating[]
  comments   Comment[]
  userId     String     @db.ObjectId
  postId     String     @unique @db.ObjectId
  createdAt  DateTime   @default(now())

  @@unique([userId, postId])
}

model User {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  username   String      @unique
  email      String      @unique
  password   String      @unique
  avatar     String?
  post       Post[]
  savedPosts SavedPost[]
  chats      Chat[]      @relation(fields: [chatIDs], references: [id])
  chatIDs    String[]    @db.ObjectId
  Rating     Rating[]
  Login     LoginInfo[]
  newsFeedposts    NewsFeedPost[]
  tags       Tag[]
  likes     Like[]  
  Comment  Comment[]
  follows   Follow[]  @relation("following") // Users they follow
  followers Follow[]  @relation("follower")  // Users following them
  shares    Share[]   // Relation to shares
  blocks    Block[]   @relation("blocker") // Users they've blocked
  blockedBy Block[]   @relation("blocked") // Users that blocked them
  notifications Notification[] 

  createdAt DateTime  @default(now())
  updatedAt DateTime?  @updatedAt 

 
}

model NewsFeedPost {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  caption    String
  media      String[]  // Media URLs (stored in S3)
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @db.ObjectId
  likes      Like[]    // Relation to likes
  comments   Comment[] // Relation to comments
  tags       Tag[]    
  shares     Share[]   // Relation to shares
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?  @updatedAt

  notification Notification[]
}
model Tag {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  newFeedPost           NewsFeedPost   @relation(fields: [newFeedPostId], references: [id], onDelete: Cascade)
  newFeedPostId         String         @db.ObjectId
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String         @db.ObjectId
  createdAt      DateTime       @default(now())
}

model Follow {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  follower     User    @relation("follower", fields: [followerId], references: [id])
  followerId   String  @db.ObjectId
  following    User   @relation("following", fields: [followingId], references: [id])
  followingId  String  @db.ObjectId
  createdAt    DateTime @default(now())
}

model Block {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  blocker   User?   @relation("blocker", fields: [blockerId], references: [id])
  blockerId String  @db.ObjectId
  blocked   User    @relation("blocked", fields: [blockedId], references: [id])
  blockedId String  @db.ObjectId
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  type      String   // 'like', 'comment', 'follow', etc.
  newsFeedPost   NewsFeedPost?    @relation(fields: [newsFeedPostId], references: [id])
  newsFeedPostId    String?  @db.ObjectId
  post   Post?    @relation(fields: [postId], references: [id])
  postId    String?  @db.ObjectId
  createdAt DateTime @default(now())
}
model Like {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  postId  String?  @db.ObjectId
  user    User?     @relation(fields: [userId], references: [id])
  userId  String   @db.ObjectId
  newsFeedPost    NewsFeedPost?     @relation(fields: [newsFeedPostId], references: [id])
  newsFeedPostId  String?   @db.ObjectId
  savedPost SavedPost? @relation(fields: [postId],references: [postId])
  createdAt DateTime @default(now())
}
model Share {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  post    Post     @relation(fields: [postId], references: [id])
  postId  String   @db.ObjectId
  newsFeedPost NewsFeedPost @relation(fields: [newFeedPostId], references: [id])
  newFeedPostId String  @db.ObjectId
  user    User?     @relation(fields: [userId], references: [id])
  userId  String   @db.ObjectId
  savedPost SavedPost? @relation(fields: [postId],references: [postId])
  createdAt DateTime @default(now())
}
model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String   @db.ObjectId
  newsFeedPost NewsFeedPost @relation(fields: [newsFeedPostId],references: [id])
  newsFeedPostId  String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  savedPost SavedPost? @relation(fields: [postId],references: [postId])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
}
model Chat {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  users       User[]    @relation(fields: [userIDs], references: [id])
  userIDs     String[]  @db.ObjectId
  createdAt   DateTime  @default(now())
  seenBy      String[]  @db.ObjectId
  messages    Message[]
  lastMessage String?
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  userId    String
  seenBy    String[] @db.ObjectId
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  stars     Float
  post      Post     @relation(fields: [postId], references: [id])
  postId    String    @db.ObjectId
  savedPost SavedPost? @relation(fields: [postId],references: [postId])
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

 // SavedPost SavedPost?

 // SavedPost SavedPost[]
}

model Hotel {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  type          String
  city          String
  address       String
  distance      String
  photos        String[]
  desc          String
  rating        Float
  rooms         String[]
  cheapestPrice Float
  featured      Boolean
  availRooms    roomBooking[]
}

model roomBooking {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  hotelId          String            @db.ObjectId
  hotelBooking     Hotel             @relation(fields: [hotelId], references: [id])
  title            String
  price            Float
  maxPeople        Int
  desc             String
  roomNumber       Int
  unavailableDates unavailableDate[]
}

model unavailableDate {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  date          DateTime
  roomBookingId String      @db.ObjectId
  roomBooking   roomBooking @relation(fields: [roomBookingId], references: [id])
}

enum Type {
  buy
  rent
  booking
}

enum Property {
  any
  apartment
  house
  villa
  PG
  hotel
  resort
  office_space
  land
}

enum FurnishingType {
  any
  full
  semi
  none
}

enum PreferredTenants {
  any
  family
  company
  bachelor_male
  bachelor_female
}

enum BHK_Type {
  any
  ONE_RK
  ONE_BHK
  TWO_BHK
  THREE_BHK
  FOUR_BHK
  FOUR_PLUS_BHK
}

enum Availability {
  immediate
  within_15_days
  within_30_days
  after_30_days
}
enum YesOrNo {
  Yes
  No
}