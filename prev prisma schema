generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Post {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  price      Int
  deposit    Int?
  rent       Int?
  sqft       Int?
  images     String[]
  address    String
  city       String
  bedroom    Int
  bathroom   Int
  latitude   String?
  longitude  String?
  type       Type
  property   Property
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  userId     String      @db.ObjectId
  postDetail PostDetail?
  savedPosts SavedPost[]
  ratings    Rating[]
  comments   Comment[]
}

model PostDetail {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  desc       String
  utilities  String?
  pet        String?
  income     String?
  size       Int?
  school     Int?
  bus        Int?
  restaurant Int?
  BHKType BHK_Type?
  furnishedType FurnishingType?
  PreferredTenants PreferredTenants?
  availableWithin Availability? 
  post       Post    @relation(fields: [postId], references: [id])
  postId     String  @unique @db.ObjectId
}

model SavedPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
//  userId    String   @unique @db.ObjectId
  userId    String    @db.ObjectId
  postId    String   @unique @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model User {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  username   String      @unique
  email      String      @unique
  password   String      @unique
  avatar     String?
  createdAt  DateTime    @default(now())
  post       Post[]
  savedPosts SavedPost[]
  chats      Chat[]      @relation(fields: [chatIDs], references: [id])
  chatIDs    String[]    @db.ObjectId
  Rating     Rating[]
  Comment    Comment[]
}

model Chat {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  users       User[]    @relation(fields: [userIDs], references: [id])
  userIDs     String[]  @db.ObjectId
  createdAt   DateTime  @default(now())
  seenBy      String[]  @db.ObjectId
  messages    Message[]
  lastMessage String?
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  userId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  stars     Float
  post      Post     @relation(fields: [postId], references: [id])
  postId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model Hotel {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  type String
  city String
  address String
  distance String
  photos String[]
  desc String
  rating Float
  rooms String[]
  cheapestPrice Float
  featured Boolean
  availRooms roomBooking[]
}

model roomBooking {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  hotelId String @db.ObjectId
  hotelBooking Hotel @relation(fields: [hotelId],references:[id])
  title String
  price Float
  maxPeople Int
  desc String
  roomNumber Int
  unavailableDates unavailableDate[]
}
model unavailableDate{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  date           DateTime
  roomBookingId  String @db.ObjectId
  roomBooking   roomBooking  @relation(fields: [roomBookingId], references: [id])
}

enum Type {
  buy
  rent
}

enum Property {
  apartment
  house
  villa
  PG
  land
}
enum FurnishingType {
  full @map("fully furnished")
  semi  @map("semi furnished")
  none  @map("not furnished")
}
enum PreferredTenants {
  family @map("families only")
  company @map("company staffs")
  bachelor_male @map("bachelor males")
  bachelor_female @map("bachelor females")
}
enum BHK_Type{
  ONE_RK @map("1 RK")
  ONE_BHK @map("1 BHK")
  TWO_BHK @map("2 BHK")
  THREE_BHK @map("3 BHK")
  FOUR_BHK @map("4 BHK")
  FOUR_PLUS_BHK @map("4+ BHK")
}
enum Availability {
  immediate @map("immediately available")
  within_15_days @map("within 15 days")
  within_30_days @map("within 30 days")
  after_30_days @map("After 30 days")
}

